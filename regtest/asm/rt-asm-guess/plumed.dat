d1: DISTANCE ATOMS=1,2
d2: DISTANCE ATOMS=3,4
asm: ASM ARG=d1,d2 ATOMS=1-6 PREPARATION_STEPS=2 STRING_MOVE_PERIOD=1 OUTPUT_PERIOD=2 FORCE_CONSTANT_L=10 FORCE_CONSTANT_D=5 GAMMA=1 POSITION_GAMMA=1 FORCE_GAMMA=1 FORCE_KAPPA=1 MAV_DAMP=0.1 DIR=./ TEMP=300 GUESS_FILE=guess.dat CHECKPOINT_PERIOD=2
PRINT ARG=asm.bias FILE=colvar FMT=%8.4f STRIDE=1
